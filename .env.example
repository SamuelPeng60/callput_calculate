# 資料庫設定
# 開發環境用 sqlite，正式環境把 DB_CONNECTION 改成 mysql 並填下面的欄位即可，
# 程式完全不用改(都透過 config/database.php 讀這裡)。
DB_CONNECTION=sqlite
DB_DATABASE=database/warrant.sqlite

# MySQL 正式環境範例(把上面兩行註解掉，改用這四行)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=warrant_analyzer
# DB_USERNAME=root
# DB_PASSWORD=

# FinMind API (盤後權證清單/歷史股價) - 免費額度 300/hr，註冊後夾 token 可到 600/hr
FINMIND_TOKEN=

# 無風險利率 / 波動率計算參數
RISK_FREE_RATE=0.015
TRADING_DAYS_PER_YEAR=240
HV_LOOKBACK_DAYS=60

# 合理/偏貴/便宜 判斷門檻 (相對合理BIV的偏離百分比)
LABEL_THRESHOLD_PCT=0.15
